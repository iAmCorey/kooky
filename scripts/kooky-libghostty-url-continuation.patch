+    const testing = std.testing;
+    const alloc = testing.allocator;
+    try oni.testing.ensureInit();
+    var config = try configpkg.Config.default(alloc);
+    defer config.deinit();
+    var derived = try DerivedConfig.init(alloc, &config);
+    defer derived.deinit();
+
+    const url = "http://127.0.0.1:5174/";
+    const cases = [_]struct { output: []const u8, full_url: []const u8 }{
+        .{ .output = "9 assets", .full_url = url ++ "9" },
+        .{ .output = "guide.html", .full_url = url ++ "guide.html" },
+        .{ .output = "guide.html for details", .full_url = url ++ "guide.html" },
+    };
+    for (cases) |case| {
+        for ([_]bool{ true, false }) |hard_break| {
+            // The second row starts at column zero in both grids.
+            var term: terminal.Terminal = try .init(std.testing.io, alloc, .{ .cols = url.len, .rows = 3 });
+            defer term.deinit(alloc);
+            var stream = term.vtStream();
+            defer stream.deinit();
+            stream.nextSlice(url);
+            if (hard_break) stream.nextSlice("\r\n");
+            stream.nextSlice(case.output);
+
+            const screen = term.screens.active;
+            const slash = screen.pages.pin(.{ .active = .{ .x = url.len - 1, .y = 0 } }).?;
+            const next_cell = screen.pages.pin(.{ .active = .{ .x = 0, .y = 1 } }).?;
+            const upper = (try linkAtScreenPin(alloc, screen, derived.links, slash, input.ctrlOrSuper(.{}))).?;
+            defer upper.deinit(alloc);
+            try testing.expectEqualStrings(if (hard_break) url else case.full_url, linkActionTarget(upper));
+            const lower = try linkAtScreenPin(alloc, screen, derived.links, next_cell, input.ctrlOrSuper(.{}));
+            defer if (lower) |link| link.deinit(alloc);
+            if (hard_break) {
+                try testing.expect(lower == null);
+            } else {
+                try testing.expectEqualStrings(case.full_url, linkActionTarget(lower.?));
+            }
+        }
+    }
+}
